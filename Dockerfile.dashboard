# Dockerfile for Enterprise Water Systems Lakehouse Dashboard
FROM python:3.9-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy dashboard application
COPY simple_dashboard.py /app/
COPY requirements.txt /app/

# Install Python dependencies
RUN pip install --no-cache-dir flask

# Create visualisations directory (will be mounted as volume)
RUN mkdir -p /app/visualisations

# Expose port
EXPOSE 9002

# Command to run the application
CMD ["python", "simple_dashboard.py"]